<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="content.mapper.TravelNoteMapper">

    <resultMap id="TravelNoteWithDetailsMap" type="content.pojo.entity.TravelNote">
        <id column="id" property="id"/>
        <result column="note_id" property="noteId"/>
        <result column="user_id" property="userId"/>
        <result column="user_name" property="userName"/>
        <result column="nick_name" property="nickName"/>
        <result column="avatar" property="avatar"/>
        <result column="destination_id" property="destinationId"/>
        <result column="destination_name" property="destinationName"/>
        <result column="title" property="title"/>
        <result column="cover_img" property="coverImg"/>
        <result column="images" property="images"/>
        <result column="content" property="content"/>
        <result column="travel_days" property="travelDays"/>
        <result column="budget" property="budget"/>
        <result column="view_count" property="viewCount"/>
        <result column="like_count" property="likeCount"/>
        <result column="comment_count" property="commentCount"/>
        <result column="status" property="status"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <select id="queryTravelNoteListWithDetails" resultMap="TravelNoteWithDetailsMap">
        SELECT
            tn.id,
            tn.note_id,
            tn.user_id,
            u.user_name,
            up.nick_name,
            up.avatar,
            tn.destination_id,
            d.name as destination_name,
            tn.title,
            tn.cover_img,
            tn.images,
            tn.content,
            tn.travel_days,
            tn.budget,
            tn.view_count,
            tn.like_count,
            tn.comment_count,
            tn.status,
            tn.sort_order,
            tn.created_at,
            tn.updated_at,
            tn.deleted
        FROM travel_note tn
        LEFT JOIN users u ON tn.user_id = u.u_uid
        LEFT JOIN user_profile up ON u.u_uid = up.u_uid
        LEFT JOIN destination d ON tn.destination_id = d.destination_id
        WHERE tn.deleted = 0
        <if test="dto.noteId != null and dto.noteId != ''">
            AND tn.note_id = #{dto.noteId}
        </if>
        <if test="dto.userId != null and dto.userId != ''">
            AND tn.user_id = #{dto.userId}
        </if>
        <if test="dto.destinationId != null and dto.destinationId != ''">
            AND tn.destination_id = #{dto.destinationId}
        </if>
        <if test="dto.title != null and dto.title != ''">
            AND tn.title LIKE CONCAT('%', #{dto.title}, '%')
        </if>
        <if test="dto.status != null">
            AND tn.status = #{dto.status}
        </if>
        ORDER BY tn.created_at DESC
        LIMIT #{dto.pageSize} OFFSET #{dto.offset}
    </select>

    <select id="countTravelNoteListWithDetails" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM travel_note tn
        WHERE tn.deleted = 0
        <if test="dto.noteId != null and dto.noteId != ''">
            AND tn.note_id = #{dto.noteId}
        </if>
        <if test="dto.userId != null and dto.userId != ''">
            AND tn.user_id = #{dto.userId}
        </if>
        <if test="dto.destinationId != null and dto.destinationId != ''">
            AND tn.destination_id = #{dto.destinationId}
        </if>
        <if test="dto.title != null and dto.title != ''">
            AND tn.title LIKE CONCAT('%', #{dto.title}, '%')
        </if>
        <if test="dto.status != null">
            AND tn.status = #{dto.status}
        </if>
    </select>

</mapper>
